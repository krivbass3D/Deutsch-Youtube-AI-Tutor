# API ключи для AI провайдеров

# Google Gemini (основной провайдер)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (резервный провайдер, используется при исчерпании лимита Gemini)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Примечания:
# - Gemini используется по умолчанию
# - При исчерпании лимита Gemini автоматически переключается на OpenAI
# - Можно использовать только один ключ, но рекомендуется иметь оба для надёжности
# - Получить Gemini API ключ: https://aistudio.google.com/
# - Получить OpenAI API ключ: https://platform.openai.com/api-keys
